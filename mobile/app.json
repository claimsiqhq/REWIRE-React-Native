{
  "expo": {
    "name": "REWIRE",
    "slug": "rewire",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rewire",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1E1E2E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rewire.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E1E2E"
      },
      "package": "com.rewire.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow REWIRE to access your photos for your vision board."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow REWIRE to access your microphone for voice features."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9cc25e77-1ea7-43a2-ad1f-57d0aeff8bd7"
      }
    },
    "owner": "claimsiq"
  }
}
